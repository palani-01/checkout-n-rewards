  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.6",
    "jest": "^30.5.2",
    "prisma": "^5.11.0",
    "supertest": "^7.3.1"
  }
}
